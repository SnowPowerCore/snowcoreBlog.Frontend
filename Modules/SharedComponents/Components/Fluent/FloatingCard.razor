@inject IJSRuntime JSRuntime

<div @ref="_root" class="floating-card @Class" style="@Style">
    <FluentCard>
        @ChildContent
    </FluentCard>
</div>

@implements IAsyncDisposable

@code
{
    private ElementReference _root;
    private IJSObjectReference? _module;

    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public string Style { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment ChildContent { get; set; } = __builder => { };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/snowcoreBlog.Frontend.SharedComponents/Components/Fluent/FloatingCard.razor.js");

            if (_module is not default(IJSObjectReference))
                await _module.InvokeVoidAsync("initializeFloatingCard", _root);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is default(IJSObjectReference))
            return;

        try
        {
            await _module.InvokeVoidAsync("disposeFloatingCard", _root);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone; observer cleanup happens implicitly.
        }

        _module = null;
    }
}