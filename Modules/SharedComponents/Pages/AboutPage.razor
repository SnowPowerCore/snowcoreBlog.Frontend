@page "/about"
@attribute [StreamRendering]

<PageTitle>About — snowcore's Blog</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Class="about-page px-3 py-4" MaxWidth="800px" HorizontalAlignment="HorizontalAlignment.Center">
    <FluentLabel Class="about-title">About</FluentLabel>

    <FluentCard Class="about-card">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Class="about-subtitle">Welcome to snowcore's Blog</FluentLabel>
            <FluentLabel>
                This is a personal blog about software development, .NET, and the everyday craft
                of building software. The main page doubles as the blog itself — highlights and
                the latest articles are right there on the front page.
            </FluentLabel>
        </FluentStack>
    </FluentCard>

    <FluentCard Class="about-card">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Class="about-subtitle">What you will find here</FluentLabel>
            <FluentList>
                <FluentListItem>Articles on .NET, ASP.NET Core, Blazor, and related technologies.</FluentListItem>
                <FluentListItem>Notes from real-world projects — including the platform running this blog.</FluentListItem>
                <FluentListItem>Highlight picks of the most interesting recent posts.</FluentListItem>
            </FluentList>
        </FluentStack>
    </FluentCard>

    <FluentCard Class="about-card">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Class="about-subtitle">The platform</FluentLabel>
            <FluentLabel>
                The site is built as a modular Blazor application backed by .NET Aspire: Fluent UI
                for the interface, PostgreSQL and Redis for storage and caching, and RabbitMQ for
                messaging between services. Articles are served through a public API layer shared
                across the frontend modules.
            </FluentLabel>
        </FluentStack>
    </FluentCard>

    <FluentCard Class="about-card">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Class="about-subtitle">Get in touch</FluentLabel>
            <FluentLabel>
                Found a typo, an error, or just want to say hi? Feel free to reach out — feedback
                is always welcome.
            </FluentLabel>
        </FluentStack>
    </FluentCard>
</FluentStack>
