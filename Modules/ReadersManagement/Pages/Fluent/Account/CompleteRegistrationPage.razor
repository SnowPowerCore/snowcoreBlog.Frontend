@using System.Text.Json
@using Apizr
@using Fido2NetLib
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using snowcoreBlog.Frontend.Infrastructure.Context
@using snowcoreBlog.Frontend.Infrastructure.Protocol
@using snowcoreBlog.Frontend.ReadersManagement.Features.Antiforgery
@using snowcoreBlog.Frontend.SharedComponents.Components.Fluent
@using snowcoreBlog.Frontend.SharedComponents.Resources.Icons
@using snowcoreBlog.PublicApi.Api
@using snowcoreBlog.PublicApi.BusinessObjects.Dto
@using snowcoreBlog.PublicApi.Extensions

@page "/register/complete"
@attribute [StreamRendering]
@inherits TimeWarpStateComponent

@inject NavigationManager Navigation
@inject WebAuthn WebAuthn
@inject IApizrManager<IReaderAccountManagementApi> ReaderAccountApi
@inject IValidator<RequestAttestationOptionsDto> RequestAttestationOptionsValidator
@inject IValidator<ConfirmCreateReaderAccountDto> ConfirmCreateReaderAccountValidator
@inject IValidator<ConfirmCreateReaderAccountWithAuthenticatorDto> ConfirmCreateReaderAccountWithAuthenticatorValidator

<FlexibleFloatingCard FloatingIcon="@(new Icons.Color.Size24.LockClosed())">
    <RegularSizeContent>
        <FluentStack Class="px-3" Orientation="Orientation.Vertical">
            <FluentSpacer />
            <FluentSpacer />
            <FluentStack Orientation="Orientation.Vertical"
                HorizontalAlignment="HorizontalAlignment.Center">
                <FluentRandomIdIcon Width="48px" Value="@(new InformationIcon())" />
                <FluentSpacer />
                <FluentLabel Alignment="HorizontalAlignment.Center">@TranslationResources.CompleteRegistrationInfoLabel</FluentLabel>
                <FluentSpacer />
                @if (_method is null)
                {
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
                        <FluentButton OnClick="@(() => _method = RegistrationMethod.Passkey)" Appearance="Appearance.Neutral">
                            @TranslationResources.CompleteRegistrationPasskeyMethodLabel
                        </FluentButton>
                        <FluentSpacer />
                        <FluentButton OnClick="@(() => _method = RegistrationMethod.Authenticator)" Appearance="Appearance.Neutral">
                            @TranslationResources.CompleteRegistrationAuthenticatorMethodLabel
                        </FluentButton>
                    </FluentStack>
                }
                else if (_method == RegistrationMethod.Passkey)
                {
                    <FluentButton OnClick="@CreatePasskeyWithLoadingAsync" Class="align-self-center" Appearance="Appearance.Neutral">
                        @TranslationResources.ContinueButtonLabel
                    </FluentButton>
                }
                else
                {
                    @if (_authenticatorSetup is null)
                    {
                        <FluentButton OnClick="@SetupAuthenticatorWithLoadingAsync" Class="align-self-center" Appearance="Appearance.Neutral">
                            @TranslationResources.ContinueButtonLabel
                        </FluentButton>
                    }
                    else
                    {
                        <div class="align-self-center">@((MarkupString)_authenticatorSetup.SvgQrCode)</div>
                        <FluentSpacer />
                        <FluentLabel Alignment="HorizontalAlignment.Center" Style="font-family: monospace;">@_authenticatorSetup.Secret</FluentLabel>
                        <FluentSpacer />
                        <FluentLabel Alignment="HorizontalAlignment.Center">@TranslationResources.CompleteRegistrationAuthenticatorSetupLabel</FluentLabel>
                        <FluentSpacer />
                        <FluentTextField Class="align-self-center" Name="code" Label="@TranslationResources.OneTimeCodeFieldLabel" InputMode="InputMode.Numeric" @bind-Value=_totpCode Required Size="40" MaxLength="6" />
                        <FluentSpacer />
                        <FluentButton OnClick="@ConfirmAuthenticatorWithLoadingAsync" Class="align-self-center" Appearance="Appearance.Accent">
                            @TranslationResources.ContinueButtonLabel
                        </FluentButton>
                    }
                }
                @foreach(var error in _completeRegErrors)
                {
                    <FluentSpacer />
                    <FluentDirectValidationMessage Message="@error" />
                }
            </FluentStack>
            <FluentSpacer />
            <FluentOverlay @bind-Visible=@_overlayVisible
                Dismissable="false"
                Transparent="false"
                Alignment="Align.Center"
                Justification="JustifyContent.Center">
                <FluentProgressRing />
            </FluentOverlay>
        </FluentStack>
    </RegularSizeContent>
</FlexibleFloatingCard>

@code
{
    private enum RegistrationMethod
    {
        Passkey,
        Authenticator
    }

    private bool _overlayVisible = false;
    private List<string> _completeRegErrors = [];
    private readonly JsonSerializerOptions _jsonOptions = new FidoBlazorSerializerContext().Options;
    private RegistrationMethod? _method = null;
    private SetupReaderAccountAuthenticatorResultDto? _authenticatorSetup = null;
    private string _totpCode = string.Empty;

    private DateTimeOffset VerificationTokenExpirationDate { get; set; } = DateTimeOffset.MinValue;

    private RequestAttestationOptionsDto PasswordlessRegistration { get; set; } = new()
    {
        Email = string.Empty,
        VerificationToken = string.Empty
    };

    [SupplyParameterFromQuery]
    private string Email
    {
        get => PasswordlessRegistration.Email;
        set => PasswordlessRegistration.Email = value;
    }

    [SupplyParameterFromQuery]
    private string VerificationToken
    {
        get => PasswordlessRegistration.VerificationToken;
        set => PasswordlessRegistration.VerificationToken = value;
    }

    [SupplyParameterFromQuery(Name = nameof(VerificationTokenExpirationDate))]
    private string VerificationTokenExpirationDateString
    {
        get => VerificationTokenExpirationDate.ToString("O");
        set
        {
            var parsed = DateTimeOffset.TryParse(value, default, System.Globalization.DateTimeStyles.RoundtripKind, out var dtOffset);
            VerificationTokenExpirationDate = parsed ? dtOffset : DateTimeOffset.MinValue;
        }
    }

    private Task CreatePasskeyWithLoadingAsync() =>
        CreatePasskeyAsync().ContinueWith(
            _ => InvokeAsync(() => _overlayVisible = false));

    private Task SetupAuthenticatorWithLoadingAsync() =>
        SetupAuthenticatorAsync().ContinueWith(
            _ => InvokeAsync(() => _overlayVisible = false));

    private Task ConfirmAuthenticatorWithLoadingAsync() =>
        ConfirmAuthenticatorAsync().ContinueWith(
            _ => InvokeAsync(() => _overlayVisible = false));

    private async Task SetupAuthenticatorAsync()
    {
        _completeRegErrors.Clear();

        if (VerificationTokenExpirationDate <= DateTimeOffset.UtcNow)
            return;

        using var tokenSource = new CancellationTokenSource();
        using var antiforgery = GetState<AntiforgeryState>();

        _overlayVisible = true;

        using var setupResponse = await ReaderAccountApi.ExecuteAsync((opt, api) =>
            api.SetupAuthenticator(new SetupReaderAccountAuthenticatorDto
            {
                Email = PasswordlessRegistration.Email,
                VerificationToken = PasswordlessRegistration.VerificationToken
            }, antiforgery.RequestVerificationToken, opt), o => o.WithCancellation(tokenSource.Token));

        var setupData = setupResponse.ToData<SetupReaderAccountAuthenticatorResultDto>(out var setupErrors);
        if (setupData is default(SetupReaderAccountAuthenticatorResultDto) && setupErrors.Count > 0)
        {
            _completeRegErrors.AddRange(setupErrors);
            return;
        }

        _authenticatorSetup = setupData;
    }

    private async Task ConfirmAuthenticatorAsync()
    {
        _completeRegErrors.Clear();

        if (VerificationTokenExpirationDate <= DateTimeOffset.UtcNow)
            return;

        using var tokenSource = new CancellationTokenSource();

        var confirmRequest = new ConfirmCreateReaderAccountWithAuthenticatorDto
        {
            Email = PasswordlessRegistration.Email,
            VerificationToken = PasswordlessRegistration.VerificationToken,
            Code = _totpCode
        };

        var confirmValidation = await ConfirmCreateReaderAccountWithAuthenticatorValidator.ValidateAsync(confirmRequest, tokenSource.Token);
        if (!confirmValidation.IsValid)
        {
            _completeRegErrors.AddRange(confirmValidation.Errors.Select(e => e.ErrorMessage));
            return;
        }

        using var antiforgery = GetState<AntiforgeryState>();

        _overlayVisible = true;

        using var createAccountResponse = await ReaderAccountApi.ExecuteAsync((opt, api) =>
            api.ConfirmCreateByAuthenticator(confirmRequest, antiforgery.RequestVerificationToken, opt), o => o.WithCancellation(tokenSource.Token));
        var createAccountData = createAccountResponse.ToData<ReaderAccountCreatedDto>(out var createAccountErrors);
        if (createAccountData is default(ReaderAccountCreatedDto) && createAccountErrors.Count > 0)
        {
            _completeRegErrors.AddRange(createAccountErrors);
            return;
        }

        Navigation.NavigateTo("login");
    }

    private async Task CreatePasskeyAsync()
    {
        _completeRegErrors.Clear();

        if (VerificationTokenExpirationDate <= DateTimeOffset.UtcNow)
            return;

        using var tokenSource = new CancellationTokenSource();

        var attestationOptionsSuccess = await RequestAttestationOptionsValidator.ValidateAsync(PasswordlessRegistration, tokenSource.Token);
        if (!attestationOptionsSuccess.IsValid)
            return;

        await WebAuthn.Init();
        _overlayVisible = true;

        using var antiforgery = GetState<AntiforgeryState>();

        using var attestationResponse = await ReaderAccountApi.ExecuteAsync((opt, api) =>
            api.RequestAttestationOptions(PasswordlessRegistration, antiforgery.RequestVerificationToken, opt), o => o.WithCancellation(tokenSource.Token));
        var attestationData = attestationResponse.ToData<CredentialCreateOptions>(out var attestationErrors, _jsonOptions);
        if (attestationData is default(CredentialCreateOptions) && attestationErrors.Count > 0)
        {
            _completeRegErrors.AddRange(attestationErrors);
            return;
        }

        var confirmAccountCreation = default(ConfirmCreateReaderAccountDto);

        try
        {
            // WebAuthn will present a native OS dialog here
            confirmAccountCreation = new ConfirmCreateReaderAccountDto
            {
                Email = PasswordlessRegistration.Email,
                VerificationToken = PasswordlessRegistration.VerificationToken,
                AuthenticatorAttestation = await WebAuthn.CreateCredsAsync(attestationData!)
            };
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            var errorMessage = e.Message;
            if (attestationData?.ExcludeCredentials?.Count > 0)
            {
                errorMessage += " (You may have already registered this device)";
            }
            _completeRegErrors.AddRange(errorMessage);
            return;
        }

        if (confirmAccountCreation is default(ConfirmCreateReaderAccountDto))
            return;
    
        var confirmAccountCreationSuccess = await ConfirmCreateReaderAccountValidator.ValidateAsync(confirmAccountCreation, tokenSource.Token);
        if (!confirmAccountCreationSuccess.IsValid)
        {
            _completeRegErrors.AddRange(confirmAccountCreationSuccess.Errors.Select(e => e.ErrorMessage));
            return;
        }
            
        using var createAccountResponse = await ReaderAccountApi.ExecuteAsync((opt, api) =>
            api.ConfirmCreateByEmail(confirmAccountCreation, antiforgery.RequestVerificationToken, opt), o => o.WithCancellation(tokenSource.Token));
        var createAccountData = createAccountResponse.ToData<ReaderAccountCreatedDto>(out var createAccountErrors);
        if (createAccountData is default(ReaderAccountCreatedDto) && createAccountErrors.Count > 0)
        {
            _completeRegErrors.AddRange(createAccountErrors);
            return;
        }

        Navigation.NavigateTo("login");
    }
}