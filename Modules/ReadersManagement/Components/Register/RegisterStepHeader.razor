<FluentStack Class="w-100" Orientation="Orientation.Vertical" VerticalGap="4">
    <FluentLabel Typo="Typography.Body" Alignment="HorizontalAlignment.Start">
        @StepCaption
    </FluentLabel>
    <FluentProgress Value="@Step" Max="@TotalSteps" />
    <FluentSpacer />
    <FluentLabel Typo="Typography.H5" Alignment="HorizontalAlignment.Start">@Title</FluentLabel>
    <FluentLabel Typo="Typography.Body" Alignment="HorizontalAlignment.Start">@Subtitle</FluentLabel>
    <FluentSpacer />
</FluentStack>
