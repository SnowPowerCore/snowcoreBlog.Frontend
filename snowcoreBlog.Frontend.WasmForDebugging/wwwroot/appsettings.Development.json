{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    // TEST VALUE: access token lifetime is 30 minutes — a 29 minute margin makes the
    // proactive rotation fire about a minute after sign-in so it can be observed.
    // Set this to 5 (or remove the override to use the code default) once verified.
    "ProactiveRefreshMarginMinutes": 29
  }
}
